<services>
  <!-- Fetch the image description from GitHub; KIWI needs no tarball -->
  <service name="obs_scm">
    <param name="url">https://github.com/tokajer/NazoOS.git</param>
    <param name="scm">git</param>
    <param name="revision">main</param>
    <param name="subdir">kiwi/nazoos-image</param>
    <param name="filename">nazoos-image</param>
    <param name="extract">config.kiwi</param>
    <param name="extract">config.sh</param>
    <param name="extract">_multibuild</param>
  </service>
</services>
