<!-- NazoOS images: test disk image (qcow2) and live ISO with installer.
     OBS builds one image per flavor in _multibuild; the flavor name
     selects the KIWI profile. -->
<!-- OBS-Profiles: @BUILD_FLAVOR@ -->
<image schemaversion="7.5" name="NazoOS">
  <description type="system">
    <author>The NazoOS Contributors</author>
    <contact>https://github.com/tokajer/NazoOS</contact>
    <specification>NazoOS gaming desktop</specification>
  </description>

  <!-- Elements without profiles="..." apply to every profile -->
  <profiles>
    <profile name="test" description="Disk image (qcow2) for virtual machines"/>
    <profile name="live" description="Live ISO with the Calamares installer"/>
  </profiles>

  <preferences>
    <version>0.1.0</version>
    <packagemanager>zypper</packagemanager>
    <locale>en_US</locale>
    <keytable>de-nodeadkeys</keytable>
    <timezone>Europe/Berlin</timezone>
    <rpm-excludedocs>true</rpm-excludedocs>
    <rpm-check-signatures>false</rpm-check-signatures>
  </preferences>

  <preferences profiles="test">
    <!-- Disk image, btrfs root as snapshot 1 so Snapper rollback works.
         No quota groups: they stall the system when Snapper deletes
         snapshots. preempt=full: full preemption via PREEMPT_DYNAMIC -->
    <type image="oem"
          format="qcow2"
          filesystem="btrfs"
          firmware="uefi"
          btrfs_root_is_snapshot="true"
          btrfs_quota_groups="false"
          fsmountoptions="noatime,compress=zstd:1"
          bootpartition="false"
          devicepersistency="by-uuid"
          kernelcmdline="quiet splash preempt=full">
      <bootloader name="grub2" timeout="5"/>
      <oemconfig>
        <oem-resize>true</oem-resize>
      </oemconfig>
      <!-- Subvolumes like a default Tumbleweed install: excluded from snapshots -->
      <systemdisk>
        <volume name="home"/>
        <volume name="root"/>
        <volume name="opt"/>
        <volume name="srv"/>
        <volume name="tmp"/>
        <volume name="usr/local"/>
        <volume name="boot/grub2/x86_64-efi" mountpoint="boot/grub2/x86_64-efi"/>
        <volume name="var" copy_on_write="false"/>
      </systemdisk>
      <!-- Virtual disk size; qcow2 is sparse, so the download stays small -->
      <size unit="G">30</size>
    </type>
  </preferences>

  <preferences profiles="live">
    <!-- Live ISO (kiwi-live, read-only root + overlay). Calamares copies
         the read-only root to disk and sets up btrfs/Snapper itself.
         No mediacheck: it needs the checkmedia package and slows boot -->
    <type image="iso"
          firmware="uefi"
          volid="NAZOOS_LIVE"
          mediacheck="false"
          kernelcmdline="quiet splash preempt=full">
      <bootloader name="grub2" timeout="5"/>
    </type>
  </preferences>

  <!-- Test accounts, password "nazoos": only for VMs, never for releases -->
  <users profiles="test">
    <user name="root" password="nazoos" pwdformat="plain" home="/root" groups="root"/>
    <user name="nazoos" password="nazoos" pwdformat="plain" home="/home/nazoos" groups="users,wheel"/>
  </users>

  <!-- Live session user (autologin). No root password: Calamares runs via
       sudo (nazoos-calamares-config) and sets the root password on install.
       The removeuser module deletes this user from the installed system -->
  <users profiles="live">
    <user name="live" password="live" pwdformat="plain" home="/home/live" groups="users"/>
  </users>

  <!-- Build repos come from the OBS project paths (repository "images") -->
  <repository type="rpm-md">
    <source path="obsrepositories:/"/>
  </repository>

  <packages type="bootstrap">
    <package name="filesystem"/>
    <package name="glibc-locale-base"/>
    <package name="ca-certificates-mozilla"/>
    <package name="udev"/>
    <package name="openSUSE-release"/>
    <package name="openSUSE-release-appliance-kvm"/>
  </packages>

  <!-- plusRecommended: also install Recommends (apps of nazoos-pattern),
       like a normal zypper install; KIWI default is no Recommends -->
  <packages type="image" patternType="plusRecommended">
    <!-- Base system -->
    <package name="patterns-base-base"/>
    <package name="kernel-default"/>
    <package name="system-group-wheel"/>
    <package name="sudo"/>
    <package name="NetworkManager"/>
    <!-- Boot: UEFI with Secure Boot shim -->
    <package name="grub2-x86_64-efi"/>
    <!-- KIWI needs the BIOS modules on x86_64 even for UEFI images -->
    <package name="grub2-i386-pc"/>
    <package name="shim"/>
    <!-- btrfs + Snapper rollback -->
    <package name="btrfsprogs"/>
    <package name="snapper"/>
    <package name="snapper-zypp-plugin"/>
    <package name="grub2-snapper-plugin"/>
    <!-- Desktop: Plasma, Wayland only (Xwayland stays for Steam/Proton) -->
    <package name="patterns-kde-kde_plasma"/>
    <package name="plasma6-session"/>
    <package name="sddm-qt6"/>
    <package name="xwayland"/>
    <!-- NazoOS -->
    <package name="nazoos-pattern"/>
    <package name="nazoos-tweaks"/>
    <package name="nazoos-branding"/>
    <!-- No X11 session (CLAUDE.md: Wayland only) -->
    <ignore name="plasma6-session-x11"/>
  </packages>

  <packages type="image" profiles="test">
    <!-- Grows the root partition to the disk size on first boot -->
    <package name="dracut-kiwi-oem-repart"/>
    <!-- Test image only: VM debugging from the host (virsh, ssh) -->
    <package name="qemu-guest-agent"/>
    <package name="openssh-server"/>
  </packages>

  <packages type="image" profiles="live">
    <!-- initrd module that boots the live system from the ISO -->
    <package name="dracut-kiwi-live"/>
    <!-- Installer + its NazoOS config (pulls in calamares) -->
    <package name="nazoos-calamares-config"/>
  </packages>
</image>
