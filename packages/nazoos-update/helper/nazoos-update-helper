"""Root part of nazoos-update.

Started by nazoos-update-check.service (action "check") and by the GUI
via pkexec ("check", "update", "rollback"); "label" by
nazoos-update-label.service. Takes no other arguments.
The status of the last check is written to STATUS as JSON, readable by
every user; the GUI and the notifier only read it.
The last output line "@@error <text>" carries a message for the user.
"""

import gettext
import json
import os
import re
import subprocess
import sys
import time
import traceback
import xml.etree.ElementTree as ET
from datetime import datetime
from pathlib import Path

# pkexec clears PYTHONPATH; load nazoos_update/status.py from the installed
# location (or from the source tree when run from a git checkout)
for base in (Path("/usr/share/nazoos-update"),
             Path(__file__).resolve().parent.parent):
    if (base / "nazoos_update" / "status.py").is_file():
        sys.path.insert(0, str(base))
        break
from nazoos_update import status  # noqa: E402

KERNEL_BOOT = "/usr/libexec/nazoos-welcome/nazoos-kernel-boot"
WELCOME_HELPER = "/usr/libexec/nazoos-welcome/nazoos-welcome-helper"
ZYPPER = ["zypper", "--non-interactive"]
FLATPAK = ["flatpak", "--system"]
# zypper exit codes that are not errors: 100-103 = informational
# (updates/reboot needed), 106 = a repository was skipped
ZYPPER_OK = (0, 100, 101, 102, 103, 106)
# Package whose version is the Tumbleweed snapshot (YYYYMMDD)
RELEASE_PKG = "openSUSE-release"
# zypper: a %post script failed, the packages are installed
ZYPPER_SCRIPT_FAILED = 107
# Package names that need a restart after the update
REBOOT_HINT = re.compile(r"^(kernel-|glibc$|systemd$|dbus|mesa|nvidia|"
                         r"libQt6|plasma|kwin|sddm)")


class Fail(Exception):
    pass


def run(cmd, check=True):
    print("$ " + " ".join(cmd), flush=True)
    rc = subprocess.run(cmd, stdin=subprocess.DEVNULL).returncode
    if check and rc != 0:
        raise Fail(f"'{cmd[0]}' failed (exit code {rc})")
    return rc


def capture(cmd):
    return subprocess.run(cmd, stdin=subprocess.DEVNULL,
                          capture_output=True, text=True)


def write_status(data):
    now = int(time.time())
    data["checked"] = now
    # Time of the last check that worked: the notifier only complains
    # about failing checks when they keep failing (laptop offline, ...)
    data["last_ok"] = now if not data.get("error") else \
        status.read_status().get("last_ok", 0)
    status.STATUS.parent.mkdir(parents=True, exist_ok=True)
    tmp = status.STATUS.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=1))
    os.chmod(tmp, 0o644)
    os.replace(tmp, status.STATUS)


# --- check ------------------------------------------------------------------

def zypper_messages(root):
    return [m.text or "" for m in root.iter("message")
            if m.get("type") == "error"]


def own_repos():
    """Enabled NazoOS repos (nazoos-repos service aliases nazoos:nazoos-devel /
    nazoos:nazoos, plus nazoos-kernel)."""
    r = capture(["zypper", "--xmlout", "repos"])
    try:
        root = ET.fromstring(r.stdout)
    except ET.ParseError:
        return []
    return [repo.get("alias") for repo in root.iter("repo")
            if (repo.get("alias") or "").startswith("nazoos")
            and repo.get("enabled") == "1"]


def own_update_cmd():
    """While the mirrors are behind: update only packages from our repos.
    "dup --from" would also replace Tumbleweed packages our kernel repo
    rebuilds (xone, xpadneo); "update -r" keeps the vendor
    (notes/update.md)."""
    repos = own_repos()
    if not repos:
        return None
    cmd = ["update", "--auto-agree-with-licenses"]
    for alias in repos:
        cmd += ["--repo", alias]
    return cmd


def dup_preview(cmd=("dist-upgrade", "--auto-agree-with-licenses")):
    """Packages a "zypper dup" (or cmd) would change, from its XML output."""
    r = capture(ZYPPER + ["--xmlout"] + list(cmd) + ["--dry-run"])
    try:
        root = ET.fromstring(r.stdout)
    except ET.ParseError:
        raise Fail("zypper returned no readable answer")
    problems = [p.findtext("description") or ""
                for p in root.iter("problem")]
    # Exit code 4: the solver found a problem the user has to decide
    if r.returncode == 4 and not problems:
        problems = zypper_messages(root) or ["dependency problem"]
    if problems:
        return None, problems
    if r.returncode not in ZYPPER_OK:
        raise Fail(" ".join(zypper_messages(root))
                   or f"zypper failed (exit code {r.returncode})")
    pkgs = []
    summary = root.find("install-summary")
    if summary is None:
        return pkgs, []
    for group in summary:
        kind = group.tag.replace("to-", "")   # upgrade, install, remove, ...
        for s in group.iter("solvable"):
            pkgs.append({
                "name": s.get("name"),
                "kind": kind,
                "type": s.get("type"),
                "old": s.get("edition-old") or "",
                "new": s.get("edition") or "",
            })
    return pkgs, []


def mirrors_behind(pkgs):
    """The repos still have an older Tumbleweed snapshot than the installed
    system (image built before the mirrors got the new snapshot): a dup
    would only downgrade. Returns (installed, mirror) or None."""
    for p in pkgs:
        if p["name"] == RELEASE_PKG and p["type"] == "package":
            old, new = p["old"][:8], p["new"][:8]
            if new.isdigit() and old.isdigit() and new < old:
                return old, new
    return None


def flatpak_updates():
    if not Path("/usr/bin/flatpak").exists():
        return []
    r = capture(FLATPAK + ["remote-ls", "--updates",
                           "--columns=application,branch"])
    apps = []
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if parts and parts[0]:
            apps.append(parts[0] + ("//" + parts[1] if len(parts) > 1 else ""))
    return apps


def check(_args=None):
    result = {"error": "", "problems": [], "packages": [], "flatpaks": []}
    r = capture(ZYPPER + ["--gpg-auto-import-keys", "refresh"])
    print(r.stdout, end="", flush=True)
    if r.returncode != 0:
        result["error"] = "refresh"
        result["detail"] = (r.stderr or r.stdout).strip()[-600:]
        write_status(result)
        raise Fail("the package sources could not be refreshed "
                   "(no internet connection?)")
    pkgs, problems = dup_preview()
    behind = None if problems else mirrors_behind(pkgs)
    if problems:
        result["error"] = "conflict"
        result["problems"] = problems
    elif behind:
        # Tumbleweed waits until the mirrors have the snapshot, our own
        # packages (branding, tweaks, ...) do not depend on it
        result["behind"] = list(behind)
        cmd = own_update_cmd()
        if cmd:
            own, own_problems = dup_preview(cmd)
            result["packages"] = [] if own_problems else own
    else:
        result["packages"] = pkgs
    result["reboot"] = any(REBOOT_HINT.match(p["name"] or "")
                           for p in result["packages"]
                           if p["type"] == "package")
    result["flatpaks"] = flatpak_updates()
    write_status(result)
    label_snapshots()
    print(f"{len(result['packages'])} package changes, "
          f"{len(result['flatpaks'])} Flatpak updates", flush=True)
    if problems:
        raise Fail("the update needs a decision: " + problems[0])


# --- update -----------------------------------------------------------------

def nazoos_key_missing():
    """kernel-nazoos on UEFI, its signing key neither enrolled nor waiting
    for MokManager: the kernel's cert-post script then fails on every
    kernel update ("mokutil --root-pw" cannot read the yescrypt root
    hash Calamares writes, ADR 0024)."""
    if capture(["mokutil", "--sb-state"]).returncode != 0:
        return False
    certs = [f for f in capture(["rpm", "-ql", "kernel-nazoos"]).stdout.split()
             if re.fullmatch(r"/etc/uefi/certs/\w+\.crt", f)]
    if not certs:
        return False
    if "already enrolled" in capture(["mokutil", "--test-key",
                                      certs[0]]).stdout.lower():
        return False
    fpr = capture(["openssl", "x509", "-in", certs[0], "-noout",
                   "-fingerprint", "-sha1"]).stdout
    fpr = fpr.split("=")[-1].strip().replace(":", "").lower()
    pending = capture(["mokutil", "--list-new"]).stdout.lower()
    return not fpr or fpr not in pending.replace(":", "")


def key_missing_quietly():
    try:
        return nazoos_key_missing()
    except OSError:   # no mokutil/openssl: not our case
        return False


def update(_args):
    key_missing = False
    run(ZYPPER + ["--gpg-auto-import-keys", "refresh"])
    pkgs, _problems = dup_preview()
    behind = mirrors_behind(pkgs or [])
    cmd = ["dist-upgrade", "--auto-agree-with-licenses"]
    if behind:
        print(f"Mirrors have Tumbleweed {behind[1]}, the system has "
              f"{behind[0]}: only NazoOS packages until they catch up",
              flush=True)
        cmd = own_update_cmd()
    if cmd:
        last = last_snapshot()
        # snapper-zypp-plugin creates a pre/post snapshot pair around this
        rc = run(ZYPPER + cmd, check=False)
        label_snapshots(update_after=last)
        if rc == ZYPPER_SCRIPT_FAILED and key_missing_quietly():
            # Installed, only the key import failed: finish the update
            # (boot entry, modules) and say what to do at the end
            key_missing = True
        elif rc not in ZYPPER_OK:
            check_quietly()
            raise Fail(f"the system update failed (zypper exit code {rc})")
        # dup only updates what is installed: kernel modules for
        # kernel-nazoos that came later (acpi_call). nazoos-welcome has
        # the list; a module missing from the repo is skipped there
        if os.access(WELCOME_HELPER, os.X_OK):
            run([WELCOME_HELPER, "kernel-sync"], check=False)
    if Path("/usr/bin/flatpak").exists():
        run(FLATPAK + ["update", "--noninteractive", "-y"], check=False)
        run(FLATPAK + ["uninstall", "--unused", "--noninteractive", "-y"],
            check=False)
    # NazoOS kernel opt-in: a kernel update adds a new boot entry, keep
    # kernel-nazoos as default (nazoos-welcome, ADR 0008)
    if os.access(KERNEL_BOOT, os.X_OK):
        run([KERNEL_BOOT, "--grub-only"], check=False)
    reboot = capture(["zypper", "needs-rebooting"]).returncode == 102
    write_status({"error": "", "problems": [], "packages": [],
                  "flatpaks": [], "reboot": False,
                  "behind": list(behind) if behind else None,
                  "needs_reboot": reboot, "updated": int(time.time())})
    if reboot:
        print("@@reboot", flush=True)
    if key_missing:
        raise Fail("the update is installed, but the NazoOS kernel key is "
                   "not enrolled: open NazoOS Welcome, page Kernel, "
                   "\"Enroll key\"")


def check_quietly():
    try:
        check()
    except Fail:
        pass


# --- snapshot names in the boot menu ---------------------------------------
# grub2-snapper-plugin shows the userdata "bootloader" instead of
# "kernel,date,pre,zypp(zypper)". It rebuilds the menu on modify-snapshot.

def snapshots():
    r = capture(["snapper", "--jsonout", "list", "--disable-used-space"])
    try:
        return json.loads(r.stdout).get("root", [])
    except ValueError:
        return []


def last_snapshot():
    return max((s["number"] for s in snapshots()), default=0)


def system_translation():
    """Labels in the language of the system (/etc/locale.conf), not of
    the helper process (LC_ALL=C for zypper)."""
    lang = ""
    try:
        for line in Path("/etc/locale.conf").read_text().splitlines():
            if line.startswith("LANG="):
                lang = line[5:].strip().strip('"').split(".")[0]
    except OSError:
        pass
    return gettext.translation("nazoos-update", languages=[lang] if lang
                               else None, fallback=True)


def snapshot_label(s, zypp_pre, is_update, _):
    """Menu text for snapshot S, None if it gets no label. _ is gettext."""
    num = s["number"]
    if s["type"] == "pre" and num in zypp_pre:
        return _("Before update") if is_update \
            else _("Before software change")
    elif s["type"] == "post" and s.get("pre-number") in zypp_pre:
        return _("After update") if is_update \
            else _("After software change")
    elif s["type"] == "single" and s.get("description") == "timeline":
        return _("Automatic snapshot")
    elif s["type"] == "single" \
            and (s.get("description") or "").startswith(
                "nazoos-update: rollback") \
            and status.subvol_readonly(f"/.snapshots/{num}/snapshot"):
        # The read-only backup snapper keeps of the state before the
        # rollback; the writable copy (new root) keeps its description
        return _("Before rollback")
    elif s["type"] == "single" and s.get("description"):
        # Made by hand, nazoos-welcome or a rollback: its own text
        return s["description"]
    return None


def label_snapshots(update_after=None):
    """Readable boot menu entries. Snapshots of the update that started
    after snapshot UPDATE_AFTER get "Before/After update", other zypper
    pairs "Before/After software change", timeline ones "Automatic", the
    rest their description; always with the local date. Snapshots that
    already have a label are left alone."""
    if not Path("/usr/bin/snapper").exists():
        return 0
    named = 0
    _ = system_translation().gettext
    # xgettext:no-python-format
    date_fmt = _("%Y-%m-%d %H:%M")
    snaps = snapshots()
    zypp_pre = {s["number"] for s in snaps if s["type"] == "pre"
                and (s.get("description") or "").startswith("zypp(")}
    for s in snaps:
        num = s["number"]
        is_update = update_after is not None and num > update_after
        # nazoos-update-label.path may have named the pair of this update
        # "software change" while zypper was running: rename those
        if num == 0 or ("bootloader" in (s.get("userdata") or {})
                        and not is_update):
            continue
        text = snapshot_label(s, zypp_pre, is_update, _)
        if text is None:
            continue
        try:
            date = datetime.strptime(s["date"], "%Y-%m-%d %H:%M:%S")
        except (KeyError, ValueError):
            continue
        # snapper splits userdata at "," and "="
        label = (text + " " + date.strftime(date_fmt)) \
            .replace(",", " ").replace("=", " ")
        capture(["snapper", "modify", "--userdata",
                 f"bootloader={label}", str(num)])
        named += 1
    return named


# --- rollback ---------------------------------------------------------------

def rollback(_args):
    num = status.booted_snapshot()
    if not num:
        raise Fail("the system was not started from a snapshot")
    # --ambit classic: also works on installs whose root subvolume is not
    # snapshot 1 (Calamares, ADR 0005). Snapper makes a backup snapshot of
    # the broken state and sets a writable copy of snapshot NUM as default.
    run(["snapper", "--ambit", "classic", "rollback",
         "--description", f"nazoos-update: rollback to {num}"])
    print("@@reboot", flush=True)


def label(_args):
    # The path unit misses changes while this runs (e.g. zypper's post
    # snapshot during our first pass): repeat until a pass names nothing
    for _round in range(10):
        if not label_snapshots():
            break
        time.sleep(2)


ACTIONS = {"check": check, "update": update, "rollback": rollback,
           "label": label}


def main():
    if os.geteuid() != 0:
        print("@@error must run as root (via pkexec)", flush=True)
        return 1
    if len(sys.argv) != 2 or sys.argv[1] not in ACTIONS:
        print("@@error unknown action", flush=True)
        return 2
    os.environ["ZYPP_LOCK_TIMEOUT"] = "300"
    os.environ["LC_ALL"] = "C.UTF-8"
    try:
        ACTIONS[sys.argv[1]](sys.argv[2:])
    except (Fail, OSError) as e:
        print(f"@@error {e}", flush=True)
        return 1
    except Exception as e:  # a bug must still reach the user as a message
        traceback.print_exc(file=sys.stdout)
        print(f"@@error {type(e).__name__}: {e}", flush=True)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
