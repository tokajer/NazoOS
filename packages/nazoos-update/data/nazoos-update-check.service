#
# Refreshes the repositories and writes the list of pending updates to
# /var/lib/nazoos-update/status.json (read by the user notifier and GUI).
[Unit]
Description=NazoOS: check for system and Flatpak updates
Documentation=https://github.com/tokajer/NazoOS/blob/main/docs/update.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/usr/share/calamares/settings.conf

[Service]
Type=oneshot
ExecStart=/usr/libexec/nazoos-update/nazoos-update-helper check
# Background job: never slow down a game
Nice=19
IOSchedulingClass=idle
StateDirectory=nazoos-update
# Exit code of a check whose result (offline, key, conflict) is in status.json
SuccessExitStatus=3
# Sandboxing. No ProtectSystem: zypper refresh and the dry run write
# /var/cache/zypp and /var/lib; snapper works through snapperd (D-Bus).
# No NoNewPrivileges: it blocks the SELinux domain transitions of
# zypper/snapper on Tumbleweed (needs a VM test first).
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
