[Unit]
Description=NazoOS: look for update notifications regularly
PartOf=graphical-session.target

[Timer]
# Soon after login: a booted snapshot must be reported at once. Only
# reads status.json, no network needed; 30 s lets Plasma's notification
# service start first
OnActiveSec=30s
OnUnitInactiveSec=1h

[Install]
WantedBy=graphical-session.target
