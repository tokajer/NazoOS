[Unit]
Description=NazoOS: check for updates regularly

[Timer]
OnBootSec=10min
# OnBootSec also covers a check missed while the computer was off
# (Persistent= would only work with OnCalendar=)
OnUnitActiveSec=6h
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
