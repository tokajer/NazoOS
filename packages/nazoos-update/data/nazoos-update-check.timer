[Unit]
Description=NazoOS: check for updates regularly

[Timer]
OnBootSec=10min
OnUnitActiveSec=6h
# Catch up a missed check after the computer was off
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
