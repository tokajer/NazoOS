#
# User unit: shows notifications for pending updates, failed checks and
# a boot from a read-only snapshot.
[Unit]
Description=NazoOS: update notifications
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/nazoos-update --notify
