<?xml version="1.0" encoding="UTF-8"?>
<!--
SPDX-FileCopyrightText: 2026 The NazoOS Contributors
SPDX-License-Identifier: GPL-3.0-or-later

Allows nazoos-update to start its root helper via pkexec. The helper
only knows the actions check, update and rollback.
Own actions so the password dialog says what really happens.
pkexec takes the FIRST action in polkit's list whose exec.path matches,
and "update" (no argv1) matches every call; the list order is not
defined. So "check" and "rollback" only get their own action when
polkit happens to list them first, else they fall back to "update".
Accepted (ADR 0031): all three steps are offered to the user anyway, the
worst case is one password dialog for "check" with the update text.
nazoos-welcome needs more (its lasting steps have their own helper path).
"check" needs no password at the computer itself: it only refreshes the
repos and does a dry run, the same as nazoos-update-check.timer does
as root every few hours.
Docs: https://www.freedesktop.org/software/polkit/docs/latest/polkit.8.html
      https://www.freedesktop.org/software/polkit/docs/latest/pkexec.1.html
-->
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>NazoOS</vendor>
  <vendor_url>https://github.com/tokajer/NazoOS</vendor_url>
  <icon_name>system-software-update</icon_name>

  <action id="org.nazoos.update.helper">
    <description>Update the system with NazoOS Update</description>
    <description xml:lang="de">Das System mit NazoOS Aktualisierung aktualisieren</description>
    <message>NazoOS Update needs administrator rights to install updates.</message>
    <message xml:lang="de">NazoOS Aktualisierung benötigt Administratorrechte, um Updates zu installieren.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nazoos-update/nazoos-update-helper</annotate>
  </action>

  <action id="org.nazoos.update.check">
    <description>Check for updates with NazoOS Update</description>
    <description xml:lang="de">Mit NazoOS Aktualisierung nach Updates suchen</description>
    <message>NazoOS Update needs administrator rights to check for updates.</message>
    <message xml:lang="de">NazoOS Aktualisierung benötigt Administratorrechte, um nach Updates zu suchen.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nazoos-update/nazoos-update-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">check</annotate>
  </action>

  <action id="org.nazoos.update.rollback">
    <description>Make a snapshot permanent with NazoOS Update</description>
    <description xml:lang="de">Mit NazoOS Aktualisierung einen Snapshot dauerhaft übernehmen</description>
    <message>NazoOS Update needs administrator rights to make the started snapshot permanent.</message>
    <message xml:lang="de">NazoOS Aktualisierung benötigt Administratorrechte, um den gestarteten Snapshot dauerhaft zu übernehmen.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nazoos-update/nazoos-update-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">rollback</annotate>
  </action>
</policyconfig>
