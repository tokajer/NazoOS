#: ../nazoos-common/nazoos_common/grub.py:115
#, python-brace-format
msgid "GRUB_CMDLINE_LINUX_DEFAULT not found in {file}"
msgstr "GRUB_CMDLINE_LINUX_DEFAULT nicht in {file} gefunden"

#: ../nazoos-common/nazoos_common/helper.py:72
#: ../nazoos-common/nazoos_common/mok.py:37
#, python-brace-format
msgid "'{cmd}' failed (exit code {rc})"
msgstr "„{cmd}“ ist fehlgeschlagen (Exit-Code {rc})"

#: ../nazoos-common/nazoos_common/helper.py:91
msgid "missing argument"
msgstr "Angabe fehlt"

#: ../nazoos-common/nazoos_common/helper.py:93
#, python-brace-format
msgid "invalid argument: {arg}"
msgstr "ungültige Angabe: {arg}"

#: ../nazoos-common/nazoos_common/helper.py:102
msgid "must run as root (via pkexec)"
msgstr "muss mit Administratorrechten laufen (über pkexec)"

#: ../nazoos-common/nazoos_common/helper.py:106
msgid "unknown action"
msgstr "unbekannte Aktion"

#: ../nazoos-common/nazoos_common/helper.py:119
#, python-brace-format
msgid "system error: {detail}"
msgstr "Systemfehler: {detail}"

#: ../nazoos-common/nazoos_common/helper.py:123
#, python-brace-format
msgid "program error: {detail}"
msgstr "Programmfehler: {detail}"

#: ../nazoos-common/nazoos_common/qt.py:151
msgid "pkexec could not be started."
msgstr "pkexec konnte nicht gestartet werden."

#: ../nazoos-common/nazoos_common/qt.py:159
msgid "Done."
msgstr "Fertig."

#: ../nazoos-common/nazoos_common/qt.py:163
msgid "Cancelled: no administrator password was given."
msgstr "Abgebrochen: Es wurde kein Administrator-Passwort eingegeben."

#: ../nazoos-common/nazoos_common/qt.py:165
msgid "Something went wrong."
msgstr "Etwas ist schiefgelaufen."

#: ../nazoos-common/nazoos_common/qt.py:276
msgid "This program is not installed."
msgstr "Dieses Programm ist nicht installiert."

#: ../nazoos-common/qml/org/nazoos/common/LogDialog.qml:13 qml/Main.qml:49
msgid "Details"
msgstr "Details"

#: ../nazoos-common/qml/org/nazoos/common/LogDialog.qml:19
msgid "Copy"
msgstr "Kopieren"

#: ../nazoos-common/qml/org/nazoos/common/LogDialog.qml:23
msgid "Copied to the clipboard."
msgstr "In die Zwischenablage kopiert."

#: ../nazoos-common/qml/org/nazoos/common/LogDialog.qml:27 qml/Main.qml:359
msgid "Close"
msgstr "Schließen"

#: ../nazoos-common/qml/org/nazoos/common/LogDialog.qml:38
msgid "Nothing has run yet."
msgstr "Bisher ist noch nichts gelaufen."

#: nazoos_update/backend.py
msgid "Checking for updates"
msgstr "Suche nach Updates"

#: nazoos_update/backend.py
msgid "Installing updates"
msgstr "Updates werden installiert"

#: nazoos_update/backend.py
msgid "Making the snapshot permanent"
msgstr "Snapshot wird dauerhaft übernommen"

#: nazoos_update/notify.py:122
msgid "Started from a snapshot"
msgstr "Von einem Snapshot gestartet"

#: nazoos_update/notify.py:123
msgid ""
"The system runs from an older, read-only snapshot. If everything works, you "
"can make this state permanent."
msgstr ""
"Das System läuft von einem älteren, schreibgeschützten Snapshot. Wenn alles "
"funktioniert, können Sie diesen Stand dauerhaft übernehmen."

#: nazoos_update/notify.py:132
msgid "Restart required"
msgstr "Neustart erforderlich"

#: nazoos_update/notify.py:135 nazoos_update/notify.py:143
msgid "Open"
msgstr "Öffnen"

#: nazoos_update/notify.py:140
msgid "NazoOS kernel runs stable"
msgstr "NazoOS-Kernel läuft stabil"

#: nazoos_update/notify.py:141
msgid ""
"The NazoOS kernel started cleanly several times in a row. Remove the "
"openSUSE kernel now?"
msgstr ""
"Der NazoOS-Kernel ist mehrmals hintereinander sauber gestartet. Den openSUSE-"
"Kernel jetzt entfernen?"

#: nazoos_update/notify.py:150
msgid "Update needs your decision"
msgstr "Update braucht Ihre Entscheidung"

#: nazoos_update/notify.py:151
msgid ""
"The update cannot be installed automatically because of a package conflict."
msgstr ""
"Das Update kann wegen eines Paketkonflikts nicht automatisch installiert "
"werden."

#: nazoos_update/notify.py:153 nazoos_update/notify.py:172
msgid "Fix"
msgstr "Beheben"

#: nazoos_update/notify.py:158
msgid "Repository key needs your decision"
msgstr "Schlüssel einer Paketquelle braucht Ihre Entscheidung"

#: nazoos_update/notify.py:159
msgid ""
"A package source offers a signing key that is not trusted yet. Updates from "
"it are blocked until you check the key."
msgstr ""
"Eine Paketquelle bietet einen Signaturschlüssel an, dem noch nicht vertraut "
"wird. Updates von dort sind gesperrt, bis Sie den Schlüssel geprüft haben."

#: nazoos_update/notify.py:162
msgid "Check key"
msgstr "Schlüssel prüfen"

#: nazoos_update/notify.py:168
msgid "Update check does not work"
msgstr "Update-Prüfung funktioniert nicht"

#: nazoos_update/notify.py:169
msgid ""
"NazoOS could not check for updates for several days. Is the computer "
"connected to the internet?"
msgstr ""
"NazoOS konnte seit mehreren Tagen nicht nach Updates suchen. Ist der "
"Computer mit dem Internet verbunden?"

#: nazoos_update/notify.py:176
#, python-format
msgid "%d update is ready to install."
msgid_plural "%d updates are ready to install."
msgstr[0] "%d Update ist bereit zur Installation."
msgstr[1] "%d Updates sind bereit zur Installation."

#: nazoos_update/notify.py:179
msgid "Updates available"
msgstr "Updates verfügbar"

#: nazoos_update/root/check.py:78
msgid "zypper returned no readable answer"
msgstr "zypper hat keine lesbare Antwort geliefert"

#: nazoos_update/root/check.py:90
#, python-brace-format
msgid "zypper reported: {detail}"
msgstr "zypper meldet: {detail}"

#: nazoos_update/root/check.py:91
#, python-brace-format
msgid "zypper failed (exit code {rc})"
msgstr "zypper ist fehlgeschlagen (Exit-Code {rc})"

#: nazoos_update/root/check.py:150
#, python-brace-format
msgid "the signing key of repository {repo} is unknown or has changed"
msgstr ""
"der Signaturschlüssel der Paketquelle {repo} ist unbekannt oder hat sich "
"geändert"

#: nazoos_update/root/check.py:152
msgid "the package sources could not be refreshed (no internet connection?)"
msgstr ""
"die Paketquellen konnten nicht aktualisiert werden (keine "
"Internetverbindung?)"

#: nazoos_update/root/check.py:177 nazoos_update/root/update.py:134
#, python-brace-format
msgid "the update needs a decision: {problem}"
msgstr "das Update braucht eine Entscheidung: {problem}"

#: nazoos_update/root/snapshots.py:56
msgid "Before update"
msgstr "Vor dem Update"

#: nazoos_update/root/snapshots.py:57
msgid "Before software change"
msgstr "Vor Software-Änderung"

#: nazoos_update/root/snapshots.py:59
msgid "After update"
msgstr "Nach dem Update"

#: nazoos_update/root/snapshots.py:60
msgid "After software change"
msgstr "Nach Software-Änderung"

#: nazoos_update/root/snapshots.py:62
msgid "Automatic snapshot"
msgstr "Automatischer Snapshot"

#: nazoos_update/root/snapshots.py:69
msgid "Before rollback"
msgstr "Vor dem Zurücksetzen"

#: nazoos_update/root/snapshots.py:130
#, no-python-format
msgid "%Y-%m-%d %H:%M"
msgstr "%d.%m.%Y %H:%M"

#: nazoos_update/root/snapshots.py:167
msgid "the system was not started from a snapshot"
msgstr "das System wurde nicht von einem Snapshot gestartet"

#: nazoos_update/root/update.py:115
#, python-brace-format
msgid "the system update failed (zypper exit code {rc})"
msgstr "das Systemupdate ist fehlgeschlagen (zypper-Exit-Code {rc})"

#: nazoos_update/root/update.py:151
msgid ""
"the update is installed, but the NazoOS kernel key is not enrolled: open "
"NazoOS Welcome, page Kernel, \"Enroll key\""
msgstr ""
"das Update ist installiert, aber der Schlüssel des NazoOS-Kernels ist nicht "
"eingetragen: Öffnen Sie NazoOS Welcome, Seite „Kernel“, „Schlüssel eintragen“"

#: qml/Main.qml:13
msgid "NazoOS Update"
msgstr "NazoOS Aktualisierung"

#: qml/Main.qml:28
msgid "never"
msgstr "nie"

#: qml/Main.qml:30
msgid "just now"
msgstr "gerade eben"

#: qml/Main.qml:31
msgid "%1 minute ago"
msgid_plural "%1 minutes ago"
msgstr[0] "vor %1 Minute"
msgstr[1] "vor %1 Minuten"

#: qml/Main.qml:33
msgid "%1 hour ago"
msgid_plural "%1 hours ago"
msgstr[0] "vor %1 Stunde"
msgstr[1] "vor %1 Stunden"

#: qml/Main.qml:34
msgid "%1 day ago"
msgid_plural "%1 days ago"
msgstr[0] "vor %1 Tag"
msgstr[1] "vor %1 Tagen"

#: qml/Main.qml:39
msgid "Updates"
msgstr "Updates"

#: qml/Main.qml:43
msgid "Check now"
msgstr "Jetzt prüfen"

#: qml/Main.qml:60 qml/Main.qml:354
msgid "Show details"
msgstr "Details anzeigen"

#: qml/Main.qml:73
msgid ""
"The system was started from snapshot %1. It is read-only: nothing can be "
"installed or changed. If everything works now, make this state permanent."
msgstr ""
"Das System wurde aus Snapshot %1 gestartet. Er ist schreibgeschützt: es kann "
"nichts installiert oder geändert werden. Wenn jetzt alles funktioniert, "
"übernimm diesen Stand dauerhaft."

#: qml/Main.qml:76 qml/Main.qml:330
msgid "Make permanent"
msgstr "Dauerhaft übernehmen"

#: qml/Main.qml:90
msgid "The snapshot was made permanent. Restart the computer to start from it."
msgstr ""
"Der Snapshot wurde dauerhaft übernommen. Starten Sie den Computer neu, um "
"ihn zu verwenden."

#: qml/Main.qml:91
msgid "Updates were installed. Restart the computer to use them."
msgstr ""
"Updates wurden installiert. Starten Sie den Computer neu, um sie zu "
"verwenden."

#: qml/Main.qml:94
msgid "Restart now"
msgstr "Jetzt neu starten"

#: qml/Main.qml:106
msgid ""
"The package sources could not be reached. Check the internet connection and "
"try again."
msgstr ""
"Die Paketquellen sind nicht erreichbar. Prüfen Sie die Internetverbindung "
"und versuchen Sie es erneut."

#: qml/Main.qml:109
msgid "Try again"
msgstr "Erneut versuchen"

#: qml/Main.qml:119
msgid ""
"A package source offers a signing key that is not trusted yet, so it cannot "
"be refreshed:"
msgstr ""
"Eine Paketquelle bietet einen Signaturschlüssel an, dem noch nicht vertraut "
"wird. Sie kann daher nicht aktualisiert werden:"

#: qml/Main.qml:121
msgid ""
"Only trust it if the provider's website shows the same fingerprint. The "
"Repair page of NazoOS Welcome can trust it."
msgstr ""
"Vertrauen Sie ihm nur, wenn die Website des Anbieters denselben "
"Fingerabdruck zeigt. Die Seite „Reparieren“ von NazoOS Welcome kann ihm "
"vertrauen."

#: qml/Main.qml:124
msgid "Open Repair"
msgstr "Reparieren öffnen"

#: qml/Main.qml:134
msgid "The update needs a decision that cannot be made automatically:"
msgstr ""
"Das Update braucht eine Entscheidung, die nicht automatisch getroffen werden "
"kann:"

#: qml/Main.qml:136
msgid ""
"In Myrlyn, Updates → Dist-Upgrade shows the conflict and the solutions to "
"choose from."
msgstr ""
"In Myrlyn zeigt Updates → Dist-Upgrade den Konflikt und die Lösungen zur "
"Auswahl an."

#: qml/Main.qml:139
msgid "Open Myrlyn"
msgstr "Myrlyn öffnen"

#: qml/Main.qml:150
msgid ""
"The download servers do not have the newest Tumbleweed version yet (system: "
"%1, servers: %2). Tumbleweed updates will appear as soon as they have it, "
"usually within a day. NazoOS's own packages can be updated now."
msgstr ""
"Die Download-Server haben die neueste Tumbleweed-Version noch nicht (System: "
"%1, Server: %2). Tumbleweed-Updates erscheinen, sobald sie dort ankommen, "
"meist innerhalb eines Tages. Die eigenen NazoOS-Pakete lassen sich schon "
"jetzt aktualisieren."

#: qml/Main.qml:174
msgid "Update on hold"
msgstr "Update angehalten"

#: qml/Main.qml:175
msgid "Updates could not be checked"
msgstr "Updates konnten nicht geprüft werden"

#: qml/Main.qml:177
msgid "%1 update available"
msgid_plural "%1 updates available"
msgstr[0] "%1 Update verfügbar"
msgstr[1] "%1 Updates verfügbar"

#: qml/Main.qml:178
msgid "Not checked yet"
msgstr "Noch nicht geprüft"

#: qml/Main.qml:178
msgid "The system is up to date"
msgstr "Das System ist aktuell"

#: qml/Main.qml:184
msgid "Last check: %1"
msgstr "Letzte Prüfung: %1"

#: qml/Main.qml:185
msgid "A restart will be needed afterwards."
msgstr "Danach ist ein Neustart nötig."

#: qml/Main.qml:191
msgid ""
"Before the update a snapshot is taken automatically. If something breaks, "
"pick it in the boot menu under \"Start bootloader from a read-only "
"snapshot\"."
msgstr ""
"Vor dem Update wird automatisch ein Snapshot erstellt. Wenn etwas "
"kaputtgeht, wählen Sie ihn im Bootmenü unter „Start bootloader from a read-"
"only snapshot“."

#: qml/Main.qml:195
msgid "Also remove Flatpak runtimes no app needs anymore"
msgstr "Auch Flatpak-Laufzeiten entfernen, die keine App mehr braucht"

#: qml/Main.qml:202
msgid "Update now"
msgstr "Jetzt aktualisieren"

#: qml/Main.qml:215
msgid "System packages"
msgstr "Systempakete"

#: qml/Main.qml:240
msgid "new"
msgstr "neu"

#: qml/Main.qml:241
msgid "removed"
msgstr "entfernt"

#: qml/Main.qml:251
msgid "Flatpak apps and runtimes"
msgstr "Flatpak-Apps und -Laufzeiten"

#: qml/Main.qml:267
msgid "Snapshots (Btrfs Assistant)"
msgstr "Snapshots (Btrfs Assistant)"

#: qml/Main.qml:272
msgid "Packages (Myrlyn)"
msgstr "Pakete (Myrlyn)"

#: qml/Main.qml:325
msgid "Make this state permanent?"
msgstr "Diesen Stand dauerhaft übernehmen?"

#: qml/Main.qml:326
msgid ""
"The system goes back to snapshot %1 for good. The current, broken state is "
"kept as a snapshot, so this can be undone. Afterwards the computer has to "
"restart."
msgstr ""
"Das System kehrt dauerhaft zu Snapshot %1 zurück. Der aktuelle, defekte "
"Stand bleibt als Snapshot erhalten, das lässt sich also rückgängig machen. "
"Danach muss der Computer neu starten."

#: qml/Main.qml:335
msgid "Cancel"
msgstr "Abbrechen"

#: qml/Main.qml:344
msgid "That did not work"
msgstr "Das hat nicht geklappt"

#: qml/Main.qml:348
msgid "Repair"
msgstr "Reparieren"

#~ msgid "Myrlyn shows the conflict and offers solutions to choose from."
#~ msgstr "Myrlyn zeigt den Konflikt und bietet Lösungen zur Auswahl an."

#~ msgid ""
#~ "The download servers do not have the newest Tumbleweed version yet "
#~ "(system: %1, servers: %2). Updates will appear as soon as they have it, "
#~ "usually within a day."
#~ msgstr ""
#~ "Die Download-Server haben die neueste Tumbleweed-Version noch nicht "
#~ "(System: %1, Server: %2). Updates erscheinen, sobald sie dort ankommen, "
#~ "meist innerhalb eines Tages."

#~ msgid ""
#~ "The system was started from snapshot %1. It is read-only: changes are "
#~ "lost at the next restart. If everything works now, make this state "
#~ "permanent."
#~ msgstr ""
#~ "Das System wurde von Snapshot %1 gestartet. Er ist schreibgeschützt: "
#~ "Änderungen gehen beim nächsten Neustart verloren. Wenn jetzt alles "
