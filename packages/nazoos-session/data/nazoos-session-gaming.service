#
# NazoOS gaming mode: tells nazoos-session-ctl that gaming mode started
# (ends a one-time switch). Pulled in by every gamescope-session-plus@
# instance via its .wants directory.
[Unit]
Description=NazoOS gaming mode started

[Service]
Type=oneshot
ExecStart=/usr/bin/nazoos-session-select --started gaming

[Install]
WantedBy=gamescope-session-plus@.service
