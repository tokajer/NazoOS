#
# NazoOS: gamescope-session-steam ships the same session twice; this
# hides the second copy from the login screen
[Desktop Entry]
Name=Steam Big Picture
Exec=gamescope-session-plus steam
Type=Application
DesktopNames=gamescope
NoDisplay=true
