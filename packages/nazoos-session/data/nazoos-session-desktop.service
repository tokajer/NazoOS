#
# NazoOS gaming mode: tells nazoos-session-ctl that the Plasma desktop
# started (boot mode "gaming": the next login is gaming mode again).
[Unit]
Description=NazoOS gaming mode: desktop started
After=plasma-workspace.target

[Service]
Type=oneshot
ExecStart=/usr/bin/nazoos-session-select --started desktop

[Install]
WantedBy=plasma-workspace.target
