 *
 * Qt stylesheet for the NazoOS branding (Calamares loads stylesheet.qss
 * from the branding directory).
 * License page: while the disclaimer is not accepted, Calamares sets a
 * fixed light pink background (#fff6f6) on the widget #acceptFrame. A
 * widget's own stylesheet always wins, so the frame cannot be recoloured
 * here. Instead the checkbox paints its own background in the theme
 * colours (Breeze Dark) over it; only the red "not accepted" border stays.
 */
#acceptFrame QCheckBox {
    background-color: palette(window);
    color: palette(window-text);
    border-radius: 3px;
    padding: 6px 10px;
}

/*
 * License page: Calamares shows the disclaimer (disclaimer.html) in a
 * QLabel without word wrap, so long lines were cut off on the right.
 * Q_PROPERTYs can be set from a stylesheet with "qproperty-<name>".
 * https://doc.qt.io/qt-6/stylesheet-syntax.html#setting-qobject-properties
 */
#licenseItemFullText {
    qproperty-wordWrap: true;
}
