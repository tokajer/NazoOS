#
# NazoOS handheld: Steam Deck services (only start on a Steam Deck, see
# 50-nazoos-steam-deck-only.conf). InputPlumber needs no entry: udev
# starts it on supported handhelds by itself.
enable jupiter-fan-control.service
enable pipewire-sysconf.service
enable wireplumber-sysconf.service
