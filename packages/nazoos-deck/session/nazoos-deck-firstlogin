#
# NazoOS handheld: once per user, at the first Plasma login
#  - "Gaming Mode" shortcut on the desktop (way back to Steam, like
#    SteamOS's "Return to Gaming Mode"); the folder name depends on the
#    language (Desktop, Schreibtisch, ...), so it is created here and not
#    by the installer
#  - Maliit as on-screen keyboard (KWin input method) unless one is set

set -u

state=${XDG_STATE_HOME:-$HOME/.local/state}/nazoos-deck
marker=$state/firstlogin-done
[ -e "$marker" ] && exit 0

# Live medium: one ISO for all devices carries this package (ADR 0020),
# desktop installs remove it. In the live session only set up a real
# handheld, not every PC that boots the ISO. The installer starter is
# there only on the live medium
if [ -x /usr/libexec/nazoos-calamares/nazoos-installer ] && \
   ! /usr/libexec/nazoos-session/nazoos-detect-handheld >/dev/null 2>&1; then
  exit 0
fi

shortcut=/usr/share/applications/org.nazoos.session.gaming.desktop
if [ -f "$shortcut" ]; then
  desktop_dir=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
  if [ -n "$desktop_dir" ] && [ "$desktop_dir" != "$HOME" ]; then
    mkdir -p "$desktop_dir"
    # Executable = trusted by Plasma, starts without a warning
    install -m0755 "$shortcut" "$desktop_dir/nazoos-gaming-mode.desktop"
  fi
fi

maliit=/usr/share/applications/com.github.maliit.keyboard.desktop
if [ -f "$maliit" ] && command -v kwriteconfig6 >/dev/null \
    && [ -z "$(kreadconfig6 --file kwinrc --group Wayland --key InputMethod 2>/dev/null)" ]; then
  kwriteconfig6 --file kwinrc --group Wayland --key InputMethod "$maliit"
  dbus-send --session --type=signal /KWin org.kde.KWin.reloadConfig 2>/dev/null || :
fi

mkdir -p "$state"
touch "$marker"
