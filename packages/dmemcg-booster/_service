<services>
  <!-- Take .spec and .changes from our GitHub repo -->
  <service name="obs_scm">
    <param name="url">https://github.com/tokajer/NazoOS.git</param>
    <param name="scm">git</param>
    <param name="revision">main</param>
    <param name="subdir">packages/dmemcg-booster</param>
    <param name="filename">dmemcg-booster-packaging</param>
    <param name="extract">dmemcg-booster.spec</param>
    <param name="extract">dmemcg-booster.changes</param>
  </service>
  <!-- Upstream release tarball: downloaded from the Source0 URL of the spec -->
  <service name="download_files"/>
  <!-- A git tag can move: the tarball must match this checksum. On a
       version update change Version in the spec and the checksum here -->
  <service name="verify_file">
    <param name="file">_service:download_files:dmemcg-booster-0.1.3.tar.gz</param>
    <param name="verifier">sha256</param>
    <param name="checksum">d8ecfabd87ad598843ce01d9f3d5e438dc9f2b67125d05013e6016d5944b9aed</param>
  </service>
  <!-- Rust crates for the offline build (OBS has no network while building):
       vendor.tar.zst. update=false keeps the versions of Cargo.lock.
       mode="manual": build.opensuse.org does not run cargo_vendor on the
       server. Run it locally on every version update and commit
       vendor.tar.zst with osc (see NazoOS-dev notes/vram.md) -->
  <service name="cargo_vendor" mode="manual">
    <param name="src">dmemcg-booster-0.1.3.tar.gz</param>
    <param name="compression">zst</param>
    <param name="update">false</param>
  </service>
</services>
