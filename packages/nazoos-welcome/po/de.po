msgstr "Handheld-Unterstützung wird installiert"

#: nazoos_welcome/catalog.py
msgid "Keeps browser profiles in RAM: faster, less disk wear"
msgstr "Hält Browser-Profile im RAM: schneller, schont die SSD"

#: nazoos_welcome/catalog.py
msgid "LACT daemon"
msgstr "LACT-Dienst"

#: nazoos_welcome/catalog.py
msgid "Logitech Unifying and Bolt receivers"
msgstr "Logitech-Unifying- und Bolt-Empfänger"

#: nazoos_welcome/catalog.py
msgid "Low-overhead recording and instant replay (like ShadowPlay)"
msgstr "Ressourcenschonende Aufnahme und Instant Replay (wie ShadowPlay)"

#: nazoos_welcome/catalog.py
msgid "Manage Flatpak permissions"
msgstr "Flatpak-Berechtigungen verwalten"

#: nazoos_welcome/catalog.py
msgid "Media player with built-in codecs"
msgstr "Mediaplayer mit eingebauten Codecs"

#: nazoos_welcome/catalog.py
msgid "Minecraft launcher with mod support"
msgstr "Minecraft-Launcher mit Mod-Unterstützung"

#: nazoos_welcome/catalog.py
msgid "Music streaming"
msgstr "Musik-Streaming"

#: nazoos_welcome/catalog.py
msgid "Needed by LACT to change GPU clocks, power and fans"
msgstr ""
"Wird von LACT benötigt, um Takt, Leistung und Lüfter der Grafikkarte zu "
"ändern"

#: nazoos_welcome/catalog.py
msgid "Office suite (about 600 MB)"
msgstr "Office-Paket (etwa 600 MB)"

