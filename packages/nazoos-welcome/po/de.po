#: nazoos_welcome/catalog.py
msgid "Repairing Flatpak"
msgstr "Flatpak wird repariert"

#: nazoos_welcome/catalog.py
msgid "Run Windows programs in managed Wine prefixes"
msgstr "Windows-Programme in verwalteten Wine-Umgebungen ausführen"

#: nazoos_welcome/catalog.py
msgid "SSH server"
msgstr "SSH-Server"

#: nazoos_welcome/catalog.py
msgid "Stream games from another PC"
msgstr "Spiele von einem anderen PC streamen"

#: nazoos_welcome/catalog.py
msgid "Streaming and recording, with Vulkan game capture"
msgstr "Streaming und Aufnahme, mit Vulkan-Spielaufnahme"

#: nazoos_welcome/catalog.py
msgid "Switching back to the openSUSE kernel"
msgstr "Zurück zum openSUSE-Kernel"

#: nazoos_welcome/catalog.py
msgid "Unlocks clock and voltage controls in LACT"
msgstr "Schaltet Takt- und Spannungsregler in LACT frei"

#: nazoos_welcome/catalog.py
msgid "Updating the system"
msgstr "System wird aktualisiert"

#: nazoos_welcome/catalog.py
