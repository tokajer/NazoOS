#: nazoos_welcome/catalog.py
msgid "Voice and text chat for gamers"
msgstr "Sprach- und Text-Chat für Spieler"

#: nazoos_welcome/catalog.py
msgid "Wireless controllers, headsets, mice and keyboards"
msgstr "Kabellose Controller, Headsets, Mäuse und Tastaturen"

