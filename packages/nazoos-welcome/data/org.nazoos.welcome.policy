<?xml version="1.0" encoding="UTF-8"?>
<!--
SPDX-FileCopyrightText: 2026 The NazoOS Contributors
SPDX-License-Identifier: GPL-3.0-or-later

Allows nazoos-welcome to start its root helpers via pkexec. The helpers
only accept fixed actions (see nazoos-welcome-helper).
pkexec takes the FIRST action in polkit's list whose exec.path matches;
an action without argv1 matches every call and the list order is not
defined. So "helper" (no argv1) is the catch-all of the normal helper,
and the steps with lasting effects have their own helper
(nazoos-welcome-helper-strict) and actions: the password dialog says what
really happens and the password is asked every time. Every action on the
strict path has an argv1 and there is no catch-all for that path, so the
order does not matter; an unknown argv1 falls back to polkit's generic
auth_admin action and the strict helper refuses it anyway.
Docs: https://www.freedesktop.org/software/polkit/docs/latest/polkit.8.html
-->
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>NazoOS</vendor>
  <vendor_url>https://github.com/tokajer/NazoOS</vendor_url>
  <icon_name>nazoos-logo</icon_name>

  <action id="org.nazoos.welcome.helper">
    <description>Change system settings with NazoOS Welcome</description>
    <description xml:lang="de">Systemeinstellungen mit NazoOS Willkommen ändern</description>
    <message>NazoOS Welcome needs administrator rights to change the system.</message>
    <message xml:lang="de">NazoOS Willkommen benötigt Administratorrechte, um das System zu ändern.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- Password is remembered for a few minutes -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nazoos-welcome/nazoos-welcome-helper</annotate>
  </action>

  <action id="org.nazoos.welcome.repair-key">
    <description>Trust a repository signing key with NazoOS Welcome</description>
    <description xml:lang="de">Einem Repository-Signaturschlüssel mit NazoOS Willkommen vertrauen</description>
    <message>NazoOS Welcome needs administrator rights to trust a repository signing key. Software from that repository is then installed with administrator rights.</message>
    <message xml:lang="de">NazoOS Willkommen benötigt Administratorrechte, um einem Repository-Signaturschlüssel zu vertrauen. Software aus diesem Repository wird danach mit Administratorrechten installiert.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nazoos-welcome/nazoos-welcome-helper-strict</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">repair-key</annotate>
  </action>

  <action id="org.nazoos.welcome.kernel-install">
    <description>Install the NazoOS kernel with NazoOS Welcome</description>
    <description xml:lang="de">Den NazoOS-Kernel mit NazoOS Willkommen installieren</description>
    <message>NazoOS Welcome needs administrator rights to install the NazoOS kernel.</message>
    <message xml:lang="de">NazoOS Willkommen benötigt Administratorrechte, um den NazoOS-Kernel zu installieren.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nazoos-welcome/nazoos-welcome-helper-strict</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">kernel-install</annotate>
  </action>

  <action id="org.nazoos.welcome.kernel-only">
    <description>Remove the openSUSE kernel with NazoOS Welcome</description>
    <description xml:lang="de">Den openSUSE-Kernel mit NazoOS Willkommen entfernen</description>
    <message>NazoOS Welcome needs administrator rights to remove the openSUSE kernel. Afterwards only the NazoOS kernel starts the computer.</message>
    <message xml:lang="de">NazoOS Willkommen benötigt Administratorrechte, um den openSUSE-Kernel zu entfernen. Danach startet nur noch der NazoOS-Kernel den Computer.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nazoos-welcome/nazoos-welcome-helper-strict</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">kernel-only</annotate>
  </action>

  <action id="org.nazoos.welcome.kernel-remove">
    <description>Remove the NazoOS kernel with NazoOS Welcome</description>
    <description xml:lang="de">Den NazoOS-Kernel mit NazoOS Willkommen entfernen</description>
    <message>NazoOS Welcome needs administrator rights to remove the NazoOS kernel and the programs that need it.</message>
    <message xml:lang="de">NazoOS Willkommen benötigt Administratorrechte, um den NazoOS-Kernel und die Programme zu entfernen, die ihn brauchen.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nazoos-welcome/nazoos-welcome-helper-strict</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">kernel-remove</annotate>
  </action>

  <action id="org.nazoos.welcome.mok-import">
    <description>Prepare the Secure Boot key with NazoOS Welcome</description>
    <description xml:lang="de">Den Secure-Boot-Schlüssel mit NazoOS Willkommen vorbereiten</description>
    <message>NazoOS Welcome needs administrator rights to prepare the Secure Boot key for the NazoOS kernel.</message>
    <message xml:lang="de">NazoOS Willkommen benötigt Administratorrechte, um den Secure-Boot-Schlüssel für den NazoOS-Kernel vorzubereiten.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nazoos-welcome/nazoos-welcome-helper-strict</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">mok-import</annotate>
  </action>

  <action id="org.nazoos.welcome.tumbleweed-switch">
    <description>Switch to openSUSE Tumbleweed with NazoOS Welcome</description>
    <description xml:lang="de">Mit NazoOS Willkommen zu openSUSE Tumbleweed wechseln</description>
    <message>NazoOS Welcome needs administrator rights to remove NazoOS and switch this computer to openSUSE Tumbleweed.</message>
    <message xml:lang="de">NazoOS Willkommen benötigt Administratorrechte, um NazoOS zu entfernen und diesen Computer auf openSUSE Tumbleweed umzustellen.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nazoos-welcome/nazoos-welcome-helper-strict</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">tumbleweed-switch</annotate>
  </action>
</policyconfig>
