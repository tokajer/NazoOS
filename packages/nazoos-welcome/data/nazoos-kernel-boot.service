#
# NazoOS kernel opt-in (ADR 0008): keeps the chosen kernel (kernel-nazoos,
# or kernel-default after "Use openSUSE kernel") as default boot entry and
# counts clean boots. Enabled by the kernel install, disabled when
# kernel-nazoos is removed; no condition on kernel-prefer, the way back
# needs it too. Type=simple, not oneshot: the script waits for the end of
# the boot, which would never come if the boot waited for it.
[Unit]
Description=NazoOS: kernel boot counter
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/libexec/nazoos-welcome/nazoos-kernel-boot

[Install]
WantedBy=multi-user.target
