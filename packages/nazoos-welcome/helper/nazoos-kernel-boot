"""Boot counter of the NazoOS kernel opt-in (ADR 0008).

Run by nazoos-kernel-boot.service at every boot while kernel-nazoos is
preferred (/var/lib/nazoos/kernel-prefer). Keeps kernel-nazoos as the
default boot entry (a kernel update creates a new entry) and counts
boots of a -nazoos kernel that reach "running". A degraded boot resets
the counter. After 3 clean boots nazoos-update offers stage 2.
After "Use openSUSE kernel" it keeps kernel-default the default instead.
--grub-only: only fix the boot entry (nazoos-update after an update).
"""

import os
import subprocess
import sys
import time
from pathlib import Path

# Our modules from the installed location (or the git checkout)
_src = Path(__file__).resolve().parent.parent
for pkg, bases in (("nazoos_welcome", ("/usr/share/nazoos-welcome", _src)),
                   ("nazoos_common", ("/usr/share/nazoos-common",
                                      _src.parent / "nazoos-common"))):
    base = next((b for b in map(Path, bases) if (b / pkg).is_dir()), None)
    if base is not None:
        sys.path.insert(0, str(base))
from nazoos_common import kernelstate  # noqa: E402
from nazoos_welcome import kernel  # noqa: E402


def main():
    # Keep the chosen kernel the default: kernel-nazoos while the user
    # prefers it, else kernel-default as long as kernel-nazoos is still
    # installed (the first menu entry would boot the newest of both)
    if kernelstate.PREFER.exists():
        flavor = "nazoos"
    elif kernel.nazoos_entry():
        flavor = "default"
    else:
        return 0
    try:
        kernel.ensure_grub_default(flavor=flavor)
    except (OSError, subprocess.CalledProcessError) as e:
        print(f"could not set the boot entry: {e}", file=sys.stderr)
    if "--grub-only" in sys.argv or flavor != "nazoos":
        return 0
    release = os.uname().release
    if not release.endswith("-nazoos"):
        # Started kernel-default on purpose (GRUB menu): neither good nor bad
        return 0
    # Waits until the boot is finished: "running" or "degraded"
    state = subprocess.run(["systemctl", "is-system-running", "--wait"],
                           capture_output=True, text=True).stdout.strip()
    boots = kernelstate.read_boots()
    count = boots.get("count", 0) + 1 if state == "running" else 0
    kernelstate.write_boots({"count": count, "kernel": release,
                             "state": state, "time": int(time.time())})
    print(f"{release}: {state}, clean boots in a row: {count}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
