"""Root part of nazoos-welcome, started via pkexec.

Only fixed actions with ids from catalog.py are accepted. Package names,
paths and commands never come from the caller. The last output line
"@@error <text>" carries a message for the user.
"""

import configparser
import contextlib
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

# pkexec clears PYTHONPATH; load catalog.py from the installed location
# (or from the source tree when run from a git checkout)
for base in (Path("/usr/share/nazoos-welcome"),
             Path(__file__).resolve().parent.parent):
    if (base / "nazoos_welcome" / "catalog.py").is_file():
        sys.path.insert(0, str(base))
        break
from nazoos_welcome import catalog, kernel  # noqa: E402

ZYPPER = ["zypper", "--non-interactive"]
ZYPPER_IN = ZYPPER + ["install", "--auto-agree-with-licenses"]
FLATPAK = ["flatpak", "--system"]
# zypper exit codes >= 100 that mean "done, but note this"
# (man zypper, EXIT CODES)
ZYPPER_INFO = {
    102: "restart the computer to finish the update",
    103: "zypper updated itself; run the action again if something is missing",
    106: "some repositories could not be refreshed and were skipped",
}
FLATHUB_URL = "https://dl.flathub.org/repo/flathub.flatpakrepo"
GRUB_DEFAULT = Path("/etc/default/grub")
FSTAB = Path("/etc/fstab")
SCX_DEFAULT = Path("/etc/default/scx")
# Root part of nazoos-update: one update path for both apps
UPDATE_HELPER = "/usr/libexec/nazoos-update/nazoos-update-helper"
# Secure Boot key (ADR 0024): the GUI sends the SHA-512 crypt hash
# (openssl passwd -6) of the password the user picked for MokManager on
# stdin, never the password itself and never on the command line
MOK_HASH = re.compile(r"\$6\$[./0-9A-Za-z]{1,16}\$[./0-9A-Za-z]{86}")
CERT_PATH = re.compile(r"/etc/uefi/certs/\w+\.crt")
RUN_DIR = Path("/run/nazoos-welcome")
EFIVARS = "/sys/firmware/efi/efivars"
# suse-module-tools blacklists ntfs3; an /etc file of the same name wins
NTFS3_BLACKLIST = "60-blacklist_fs-ntfs3.conf"


class Fail(Exception):
    pass


def run(cmd, check=True):
    print("$ " + " ".join(cmd), flush=True)
    rc = subprocess.run(cmd, stdin=subprocess.DEVNULL).returncode
    if cmd[0] == "zypper" and rc in ZYPPER_INFO:
        print(f"Note: {ZYPPER_INFO[rc]}", flush=True)
        return 0
    if check and rc != 0:
        raise Fail(f"'{cmd[0]}' failed (exit code {rc})")
    return rc


def output(cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def rpm_installed(name):
    return subprocess.run(["rpm", "-q", "--quiet", name]).returncode == 0


def arg(args, i, allowed=None):
    if len(args) <= i:
        raise Fail("missing argument")
    if allowed is not None and args[i] not in allowed:
        raise Fail(f"invalid argument: {args[i]}")
    return args[i]


def repo_with_url(fragment):
    for f in Path("/etc/zypp/repos.d").glob("*.repo"):
        text = f.read_text(errors="replace")
        if fragment in text:
            m = re.search(r"^\[(.+)\]", text, re.M)
            if m:
                return m.group(1)
    return None


def repo_with_path(path):
    """Alias of an opensuse.org repo by URL path (any mirror host)."""
    for f in Path("/etc/zypp/repos.d").glob("*.repo"):
        alias = None
        for line in f.read_text(errors="replace").splitlines():
            m = re.match(r"\[(.+)\]\s*$", line)
            if m:
                alias = m.group(1)
            m = re.match(r"baseurl\s*=\s*(\S+)", line)
            if (m and alias and "opensuse.org" in m.group(1)
                    and catalog.repo_path(m.group(1)) == path):
                return alias
    return None


# --- Drivers and codecs ---------------------------------------------------

def packman_switch(alias):
    """Switch installed multimedia packages to Packman's builds."""
    run(ZYPPER + ["--gpg-auto-import-keys", "refresh", alias])
    run(ZYPPER + ["dist-upgrade", "--auto-agree-with-licenses", "--from",
                  alias, "--allow-vendor-change", "--allow-downgrade"])


def codecs_install(_args):
    alias = repo_with_url("/packman/") or catalog.PACKMAN_ALIAS
    if not repo_with_url("/packman/"):
        run(ZYPPER + ["addrepo", "--refresh", "--priority",
                      catalog.PACKMAN_PRIORITY, "--name", "Packman",
                      catalog.PACKMAN_URL, alias])
    packman_switch(alias)
    run(ZYPPER_IN + ["--from", alias] + catalog.PACKMAN_CODECS)
    run(ZYPPER_IN + catalog.OSS_CODECS)


def nvidia_install(args):
    variant = arg(args, 0, catalog.NVIDIA_DRIVERS)
    alias = repo_with_url("download.nvidia.com") or catalog.NVIDIA_REPO_ALIAS
    if not repo_with_url("download.nvidia.com"):
        run(ZYPPER + ["addrepo", "--refresh", "--name", "NVIDIA",
                      catalog.NVIDIA_REPO_URL, alias])
    run(ZYPPER + ["--gpg-auto-import-keys", "refresh", alias])
    run(ZYPPER_IN + catalog.NVIDIA_DRIVERS[variant])
    print("Restart the computer to load the NVIDIA driver.", flush=True)


def rocm_install(_args):
    run(ZYPPER_IN + catalog.ROCM_PACKAGES)
    print("Restart programs like Blender so they find the GPU.", flush=True)


def rocm_remove(_args):
    pkgs = [p for p in catalog.ROCM_PACKAGES if rpm_installed(p)]
    if pkgs:
        run(ZYPPER + ["remove", "--clean-deps"] + pkgs)


# --- Performance -----------------------------------------------------------

def scx_enable(args):
    sched = arg(args, 0, catalog.SCX_SCHEDULERS)
    if not rpm_installed("scx"):
        run(ZYPPER_IN + ["scx"])
    if not Path("/usr/bin", sched).exists():
        raise Fail(f"{sched} is not part of the installed scx package")
    lines = SCX_DEFAULT.read_text().splitlines() if SCX_DEFAULT.exists() else []
    out, done = [], False
    for line in lines:
        if re.match(r"\s*SCX_SCHEDULER\s*=", line):
            if not done:
                out.append(f"SCX_SCHEDULER={sched}")
                done = True
        else:
            out.append(line)
    if not done:
        out.append(f"SCX_SCHEDULER={sched}")
    SCX_DEFAULT.write_text("\n".join(out) + "\n")
    print(f"{SCX_DEFAULT}: SCX_SCHEDULER={sched}", flush=True)
    run(["systemctl", "enable", "scx.service"])
    run(["systemctl", "restart", "scx.service"])


def scx_disable(_args):
    run(["systemctl", "disable", "--now", "scx.service"])


def cmdline():
    """GRUB file text, match of GRUB_CMDLINE_LINUX_DEFAULT, its options."""
    text = GRUB_DEFAULT.read_text()
    m = re.search(r'^GRUB_CMDLINE_LINUX_DEFAULT=(["\']?)(.*?)\1\s*$',
                  text, re.M)
    if m is None:
        raise Fail(f"GRUB_CMDLINE_LINUX_DEFAULT not found in {GRUB_DEFAULT}")
    return text, m, m.group(2).split()


def cmdline_set(key, option):
    """Replace the option `key` (or key=...) with `option`, None removes it."""
    text, m, opts = cmdline()
    opts = [o for o in opts if o.split("=")[0] != key]
    if option is not None:
        opts.append(option)
    line = 'GRUB_CMDLINE_LINUX_DEFAULT="' + " ".join(opts) + '"'
    GRUB_DEFAULT.write_text(text[:m.start()] + line + text[m.end():])
    print(line, flush=True)
    grub_refresh()


def kparam(args):
    item = catalog.by_id(catalog.KERNEL_PARAMS, arg(args, 0))
    if item is None:
        raise Fail("unknown kernel option")
    enable = arg(args, 1, ("on", "off")) == "on"
    cmdline_set(item["param"].split("=")[0],
                item["param"] if enable else None)
    print("The change takes effect after a restart.", flush=True)


def usb_ids():
    """VID:PID of all connected USB devices."""
    ids = set()
    for dev in Path("/sys/bus/usb/devices").glob("*"):
        try:
            ids.add((dev / "idVendor").read_text().strip() + ":"
                    + (dev / "idProduct").read_text().strip())
        except OSError:
            pass
    return ids


def pollrate(args):
    """USB polling rate of one device (kernel-nazoos patch 0022)."""
    sysfs = Path(catalog.POLLRATE_SYSFS)
    if not sysfs.exists():
        raise Fail("needs the NazoOS kernel")
    vidpid = arg(args, 0)
    if not re.fullmatch(r"[0-9a-f]{4}:[0-9a-f]{4}", vidpid):
        raise Fail("invalid device id")
    ms = int(arg(args, 1, [str(i) for i in catalog.POLLRATE_INTERVALS]))
    overrides = {}
    for opt in cmdline()[2]:
        if opt.startswith(catalog.POLLRATE_PARAM + "="):
            overrides = catalog.pollrate_parse(opt.split("=", 1)[1])
    if ms == 0:
        overrides.pop(vidpid, None)
    elif vidpid in usb_ids() or vidpid in overrides:
        overrides[vidpid] = ms
    else:
        raise Fail("this device is not connected")
    value = catalog.pollrate_format(overrides)
    if len(value) > catalog.POLLRATE_MAXLEN:
        raise Fail("too many devices with their own polling rate; reset one "
                   "of them to the device default first")
    cmdline_set(catalog.POLLRATE_PARAM,
                f"{catalog.POLLRATE_PARAM}={value}" if value else None)
    # Now as well, not only after a restart: usbcore reads the list when a
    # device is plugged in. An empty write would not reach the kernel
    sysfs.write_text(value or "\n")
    print("Unplug the device and plug it in again to use the new rate.",
          flush=True)


def grub_refresh():
    if Path("/usr/sbin/update-bootloader").exists():
        run(["update-bootloader", "--refresh"])
    else:
        run(["grub2-mkconfig", "-o", "/boot/grub2/grub.cfg"])


def deck_install(_args):
    run(ZYPPER + ["--gpg-auto-import-keys", "refresh"])
    run(ZYPPER_IN + ["--type", "pattern", catalog.DECK_PATTERN])


def session_boot_mode(args):
    """Start in Steam's gaming mode (autologin of the calling user) or
    with the normal login screen (nazoos-session-ctl)."""
    mode = arg(args, 0, ("gaming", "desktop"))
    if not Path(catalog.SESSION_CTL).exists():
        raise Fail("gaming mode is not installed (nazoos-session)")
    if mode == "gaming":
        uid = int(os.environ.get("PKEXEC_UID", "-1"))
        user = output(["id", "-nu", str(uid)]).strip()
        if uid < 1000 or not user:
            raise Fail("unknown user")
        run([catalog.SESSION_CTL, "boot-mode", "gaming", user])
    else:
        run([catalog.SESSION_CTL, "boot-mode", "desktop"])


# --- NazoOS kernel (ADR 0008) ----------------------------------------------

def running_nazoos():
    return os.uname().release.endswith("-nazoos")


def repo_has(alias, name):
    """Package `name` exists in repo `alias` (zypper exit 104: not found)."""
    return subprocess.run(
        ZYPPER + ["--quiet", "search", "--match-exact", "--repo", alias,
                  name], stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL).returncode == 0


def kernel_install(_args):
    """Stage 1: kernel-nazoos next to kernel-default, default boot entry."""
    blockers = [p for p in catalog.KMP_DEFAULT_ONLY if rpm_installed(p)]
    if blockers:
        raise Fail("the closed NVIDIA driver (G06) only exists for the "
                   "openSUSE kernel; switch to the open driver first")
    fragment = catalog.KERNEL_REPO_URL.split("/repositories/")[1]
    alias = repo_with_url(fragment)
    if alias is None:
        alias = catalog.KERNEL_REPO_ALIAS
        run(ZYPPER + ["addrepo", "--refresh", "--priority", "90", "--name",
                      "NazoOS kernel", catalog.KERNEL_REPO_URL, alias])
    run(ZYPPER + ["--gpg-auto-import-keys", "refresh", alias])
    # Same kernel modules as for kernel-default (NVIDIA, Xbox controllers).
    # Check first that our kernel project builds them: without its NVIDIA
    # module kernel-nazoos would start without graphics driver
    kmps = [f"{b}-kmp-nazoos" for b in catalog.KMP_BASES
            if rpm_installed(f"{b}-kmp-default")]
    missing = [p for p in kmps if not repo_has(alias, p)]
    gpu = [p for p in missing if p.startswith("nvidia-")]
    if gpu:
        raise Fail("the NazoOS kernel has no build of your NVIDIA driver ("
                   + ", ".join(gpu) + "); switch to the open NVIDIA driver "
                   "on the Drivers page first")
    for p in missing:
        print(f"Note: {p} is not available, the device works only with "
              "the openSUSE kernel", flush=True)
    # Modules only kernel-nazoos has (acpi_call): optional, skip if the
    # repo has no build yet
    extra = [p for p in (f"{b}-kmp-nazoos" for b in catalog.KMP_NAZOOS_ONLY)
             if repo_has(alias, p)]
    pkgs = [catalog.KERNEL_PACKAGE] + [p for p in kmps if p not in missing] \
        + extra
    queued = False
    if uefi():
        # The kernel's %post (cert-post) runs "mokutil --import --root-pw".
        # That fails on Calamares installs (yescrypt root hash, ADR 0024)
        # and zypper ends with 107. A request already waiting for
        # MokManager makes it skip, so ours goes first: download, take the
        # certificate out of the package, queue it, then install
        if rpm_installed(catalog.KERNEL_PACKAGE):
            cert = kernel_cert()
        else:
            run(ZYPPER_IN + ["--download-only"] + pkgs)
            cert = cert_from_download(alias)
        if cert is None:
            raise Fail("kernel-nazoos has no signing certificate")
        try:
            queued = mok_queue(cert)
        finally:
            if cert.startswith(str(RUN_DIR)):
                Path(cert).unlink(missing_ok=True)
    run(ZYPPER_IN + pkgs)
    kernel.STATE.mkdir(parents=True, exist_ok=True)
    kernel.PREFER.touch()
    kernel.write_boots({"count": 0})
    kernel.ensure_grub_default(lambda m: print(m, flush=True))
    run(["systemctl", "enable", "nazoos-kernel-boot.service"])
    if queued:
        print(MOK_RESTART, flush=True)
    else:
        print("Restart the computer to start the NazoOS kernel.", flush=True)


def kernel_only(_args):
    """Stage 2: remove kernel-default for good (nazoos-kernel-only)."""
    if not running_nazoos():
        raise Fail("start the NazoOS kernel first")
    remove = [f"-{p}" for p in
              [catalog.KERNEL_DEFAULT, "kernel-default-base"]
              + [f"{b}-kmp-default" for b in catalog.KMP_BASES]
              if rpm_installed(p)]
    # "-name" removes in the same transaction: zypper never has to pick a
    # conflict solution on its own
    run(ZYPPER_IN + [catalog.KERNEL_ONLY_PACKAGE] + remove)


def kernel_restore(_args):
    """Way back: openSUSE kernel as default again, kernel-nazoos stays."""
    pkgs = [catalog.KERNEL_DEFAULT] + [
        f"{b}-kmp-default" for b in catalog.KMP_BASES
        if rpm_installed(f"{b}-kmp-nazoos")]
    if rpm_installed(catalog.KERNEL_ONLY_PACKAGE):
        pkgs.append(f"-{catalog.KERNEL_ONLY_PACKAGE}")
    run(ZYPPER_IN + pkgs)
    kernel.PREFER.unlink(missing_ok=True)
    # The top entry boots the newest kernel of any flavor, often
    # kernel-nazoos: pin it to kernel-default (nazoos-kernel-boot keeps
    # this after updates)
    if not kernel.ensure_grub_default(lambda m: print(m, flush=True),
                                      flavor="default"):
        raise Fail("the openSUSE kernel is not in /boot")
    print("Restart the computer to start the openSUSE kernel.", flush=True)


def kernel_remove(_args):
    """Remove kernel-nazoos completely (only from the openSUSE kernel)."""
    if running_nazoos():
        raise Fail("start the openSUSE kernel first (boot menu)")
    if not rpm_installed(catalog.KERNEL_DEFAULT):
        raise Fail("the openSUSE kernel is not installed")
    pkgs = [p for p in [catalog.KERNEL_PACKAGE, catalog.KERNEL_ONLY_PACKAGE]
            + [f"{b}-kmp-nazoos"
               for b in catalog.KMP_BASES + catalog.KMP_NAZOOS_ONLY]
            if rpm_installed(p)]
    if pkgs:
        with efivars_read_only():
            run(ZYPPER + ["remove", "--clean-deps"] + pkgs)
    kernel.PREFER.unlink(missing_ok=True)
    kernel.clear_grub_top_level(lambda m: print(m, flush=True))
    run(["systemctl", "disable", "nazoos-kernel-boot.service"], check=False)


@contextlib.contextmanager
def efivars_read_only():
    """The kernel's cert-postun would queue our key for removal with
    "mokutil --delete --root-pw", which fails on Calamares installs
    (yescrypt, ADR 0024) and ends zypper with 107. With a read-only
    efivarfs the script skips certificate handling; the key stays
    enrolled (harmless, a later install needs no MokManager step)."""
    try:
        was_rw = not os.statvfs(EFIVARS).f_flag & os.ST_RDONLY
    except OSError:
        was_rw = False
    if was_rw:
        run(["mount", "-o", "remount,ro", EFIVARS], check=False)
    try:
        yield
    finally:
        if was_rw:
            run(["mount", "-o", "remount,rw", EFIVARS], check=False)


def kernel_sync(_args):
    """Kernel modules for kernel-nazoos that came after it was installed.

    Run by nazoos-update after "zypper dup", which only updates installed
    packages: a new KMP_NAZOOS_ONLY module (acpi_call), or a driver
    installed for kernel-default later (xone after kernel-nazoos), would
    never arrive. Only takes what the kernel repo has: a module that does
    not build right now is skipped and the update goes on (no hard
    Requires, kernel and packages stay separate).
    """
    if not rpm_installed(catalog.KERNEL_PACKAGE):
        return
    fragment = catalog.KERNEL_REPO_URL.split("/repositories/")[1]
    alias = repo_with_url(fragment)
    if alias is None:
        print("Note: the NazoOS kernel repository is missing, kernel "
              "modules are not checked", flush=True)
        return
    wanted = [f"{b}-kmp-nazoos" for b in catalog.KMP_BASES
              if rpm_installed(f"{b}-kmp-default")]
    wanted += [f"{b}-kmp-nazoos" for b in catalog.KMP_NAZOOS_ONLY]
    new = [p for p in wanted
           if not rpm_installed(p) and repo_has(alias, p)]
    if new:
        run(ZYPPER_IN + new)


MOK_RESTART = ("Restart: the blue MokManager screen appears. Choose "
               "\"Enroll MOK\", \"Continue\", \"Yes\" and type the password "
               "you chose (suggested: nazoos).")


def kernel_cert():
    files = output(["rpm", "-ql", catalog.KERNEL_PACKAGE]).split()
    certs = [f for f in files if CERT_PATH.fullmatch(f)]
    return certs[0] if certs else None


def uefi():
    """mokutil answers = UEFI. The kernel's cert-post script then calls
    mokutil, with Secure Boot on or off."""
    try:
        return subprocess.run(["mokutil", "--sb-state"],
                              capture_output=True).returncode == 0
    except FileNotFoundError:
        return False


def cert_from_download(alias):
    """Signing certificate inside the kernel package that
    "zypper install --download-only" just put into the cache."""
    cache = Path("/var/cache/zypp/packages") / alias
    rpms = sorted(cache.rglob(f"{catalog.KERNEL_PACKAGE}-[0-9]*.rpm"),
                  key=lambda f: f.stat().st_mtime)
    if not rpms:
        raise Fail("the downloaded kernel package was not found")
    files = output(["rpm", "-qlp", str(rpms[-1])]).split()
    certs = [f for f in files if CERT_PATH.fullmatch(f)]
    if not certs:
        return None
    # rpm2cpio | cpio: the payload paths start with "./"
    unpack = subprocess.Popen(["rpm2cpio", str(rpms[-1])],
                              stdout=subprocess.PIPE)
    data = subprocess.run(["cpio", "--extract", "--to-stdout", "--quiet",
                           "." + certs[0]], stdin=unpack.stdout,
                          capture_output=True).stdout
    unpack.stdout.close()
    unpack.wait()
    if b"BEGIN CERTIFICATE" not in data and not data.startswith(b"\x30"):
        raise Fail("the signing certificate could not be read")
    RUN_DIR.mkdir(mode=0o700, exist_ok=True)
    # Same file name as on the installed system
    cert = RUN_DIR / Path(certs[0]).name
    cert.write_bytes(data)
    return str(cert)


def mok_status(cert):
    """enrolled, pending (waiting for MokManager) or missing."""
    if "already enrolled" in output(["mokutil", "--test-key", cert]).lower():
        return "enrolled"
    fpr = output(["openssl", "x509", "-in", cert, "-noout", "-fingerprint",
                  "-sha1"]).split("=")[-1].strip().replace(":", "").lower()
    pending = output(["mokutil", "--list-new"]).lower().replace(":", "")
    return "pending" if fpr and fpr in pending else "missing"


def mok_queue(cert):
    """Queue CERT for MokManager with the password from the GUI.
    Returns False if nothing had to be done."""
    status = mok_status(cert)
    if status != "missing":
        if status == "pending":
            # Queued by someone else (cert-post): let the GUI show it too
            kernel.STATE.mkdir(parents=True, exist_ok=True)
            kernel.MOK_REQUESTED.touch()
        print(f"Secure Boot key: {status}, nothing to do", flush=True)
        return False
    mok_hash = sys.stdin.readline().strip()
    if not MOK_HASH.fullmatch(mok_hash):
        raise Fail("a password for the Secure Boot key is needed")
    RUN_DIR.mkdir(mode=0o700, exist_ok=True)
    hash_file = RUN_DIR / "mok.hash"
    fd = os.open(hash_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(mok_hash + "\n")
    try:
        # Same options as cert-post: --ignore-keyring, or mokutil skips a
        # key the running kernel already trusts (kernel-nazoos itself)
        rc = run(["mokutil", "--import", cert, "--hash-file", str(hash_file),
                  "--ca-check", "--ignore-keyring"], check=False)
    finally:
        hash_file.unlink(missing_ok=True)
    if rc != 0:
        raise Fail(f"the Secure Boot key could not be prepared (mokutil "
                   f"exit code {rc})")
    kernel.STATE.mkdir(parents=True, exist_ok=True)
    kernel.MOK_REQUESTED.touch()
    return True


def mok_import(_args):
    """Queue our signing certificate for MokManager again (button on the
    kernel page), with a password the user picks (ADR 0024)."""
    cert = kernel_cert()
    if cert is None:
        raise Fail("kernel-nazoos has no signing certificate")
    if mok_queue(cert):
        print(MOK_RESTART, flush=True)


# --- Apps --------------------------------------------------------------------

def flathub_ensure():
    run(FLATPAK + ["remote-add", "--if-not-exists", "flathub", FLATHUB_URL])


def flatpak_branches():
    listing = output(FLATPAK + ["remote-ls", "flathub",
                                "--columns=application,branch"])
    branches = {}
    for line in listing.splitlines():
        parts = line.split("\t")
        if len(parts) == 2:
            branches.setdefault(parts[0], set()).add(parts[1])
    return branches


def runtime_branch(app_ref):
    """Branch of the runtime an installed app uses, e.g. "25.08"."""
    runtime = output(FLATPAK + ["info", "--show-runtime", app_ref]).strip()
    return runtime.rsplit("/", 1)[-1] if runtime.count("/") == 2 else ""


def app_install(args):
    app = catalog.by_id(catalog.APPS, arg(args, 0))
    if app is None:
        raise Fail("unknown app")
    if app.get("kernel") == "nazoos" and not running_nazoos():
        raise Fail(f"{app['name']} needs the NazoOS kernel (Kernel page)")
    if app["kind"] != "flatpak":
        run(ZYPPER_IN + app["refs"])
        for unit in app.get("units", []):
            run(["systemctl", "enable", "--now", unit])
        firewall_trust(app.get("trusted", []), True)
        if app["id"] == "waydroid":
            waydroid_config()
        return
    flathub_ensure()
    # Extensions like Vulkan layers exist once per runtime version and
    # cannot be installed without a branch. Install the app first, then
    # pick the branch of the runtime it uses (newest as fallback).
    branches = flatpak_branches()
    single = [r for r in app["refs"] if len(branches.get(r, ())) <= 1]
    multi = [r for r in app["refs"] if len(branches.get(r, ())) > 1]
    run(FLATPAK + ["install", "--noninteractive", "-y", "flathub"] + single)
    if multi:
        wanted = runtime_branch(app["refs"][0])

        def key(b):
            return [int(x) if x.isdigit() else -1 for x in b.split(".")]

        refs = []
        for ref in multi:
            found = branches[ref]
            branch = wanted if wanted in found else max(found, key=key)
            refs.append(f"{ref}//{branch}")
        run(FLATPAK + ["install", "--noninteractive", "-y", "flathub"] + refs)


def app_remove(args):
    app = catalog.by_id(catalog.APPS, arg(args, 0))
    if app is None:
        raise Fail("unknown app")
    if app["kind"] == "flatpak":
        # One by one: removing the app also removes its own extensions
        for ref in app["refs"]:
            installed = output(FLATPAK + ["list",
                                          "--columns=application"]).split()
            if ref in installed:
                run(FLATPAK + ["uninstall", "--noninteractive", "-y", ref])
    else:
        for unit in app.get("units", []):
            run(["systemctl", "disable", "--now", unit], check=False)
        run(ZYPPER + ["remove", "--clean-deps"] + app["refs"])
        firewall_trust(app.get("trusted", []), False)


def in_vm():
    return subprocess.run(["systemd-detect-virt", "--vm", "--quiet"]
                          ).returncode == 0


def waydroid_config():
    """Android properties for Waydroid: the time zone of the system
    (Android runs in UTC otherwise) and, in a VM, software rendering
    (catalog.WAYDROID_SOFTWARE). Written before Waydroid's first start:
    its init loads an existing config and keeps [properties]. Already set
    up: rebuild Android's properties now, they are only generated by init
    and upgrade."""
    wanted = {}
    tz = output(["timedatectl", "show", "--property=Timezone",
                 "--value"]).strip()
    if re.fullmatch(r"[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*", tz):
        wanted["persist.sys.timezone"] = tz
    if in_vm():
        wanted.update(catalog.WAYDROID_SOFTWARE)
    path = Path(catalog.WAYDROID_CONFIG)
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.read(path)
    if "properties" not in cfg:
        cfg["properties"] = {}
    props = cfg["properties"]
    if all(props.get(k) == v for k, v in wanted.items()):
        return
    if in_vm():
        print("Virtual machine: Waydroid uses software rendering", flush=True)
    props.update(wanted)
    # 0755 like Waydroid's own: the GUI reads the config as the user
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    with open(path, "w") as f:
        cfg.write(f)
    if Path(catalog.WAYDROID_ROOTFS).is_dir():
        run(["waydroid", "upgrade", "--offline"])


def firewall_trust(ifaces, add):
    """Put network interfaces of an app into firewalld's trusted zone."""
    if not ifaces or subprocess.run(
            ["systemctl", "is-active", "--quiet", "firewalld"]).returncode:
        return
    op = "--add" if add else "--remove"
    for iface in ifaces:
        run(["firewall-cmd", "--permanent", "--zone=trusted",
             f"{op}-interface={iface}"], check=False)
    if add:
        # Forwarding inside the zone: Android reaches the internet via the
        # host. Not taken back on removal: other interfaces may need it
        run(["firewall-cmd", "--permanent", "--zone=trusted", "--add-forward"],
            check=False)
    run(["firewall-cmd", "--reload"], check=False)


