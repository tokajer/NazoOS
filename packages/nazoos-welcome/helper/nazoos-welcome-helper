def repair_nvidia(_args):
    release = os.uname().release
    flavor = release.rsplit("-", 1)[-1]
    # The module type that is installed for any kernel: G06 exists as open
    # (SUSE-signed) and closed build, both with nvidia-video-G06
    installed = output(["rpm", "-qa", "--qf", "%{NAME}\n"]).split()
    bases = [b for b in ("nvidia-open-driver-G07-signed",
                         "nvidia-open-driver-G06-signed", "nvidia-driver-G06")
             if any(n.startswith(f"{b}-kmp-") for n in installed)]
    if bases:
        kmp = f"{bases[0]}-kmp-{flavor}"
    elif rpm_installed("nvidia-video-G07"):
        kmp = f"nvidia-open-driver-G07-signed-kmp-{flavor}"
    elif rpm_installed("nvidia-video-G06"):
        kmp = f"nvidia-driver-G06-kmp-{flavor}"
    else:
        raise Fail("no NVIDIA driver is installed")
    run(ZYPPER + ["--gpg-auto-import-keys", "refresh"])
    run(ZYPPER_IN + ["--force", kmp])
    run(["dracut", "--force", "--kver", release])
    print("Restart the computer to load the NVIDIA driver.", flush=True)


def failed_units():
    units = [line.split()[0] for line in output(
        ["systemctl", "list-units", "--failed", "--plain",
         "--no-legend"]).splitlines() if line.strip()]
    return [u for u in units if u not in catalog.IGNORED_UNITS
            and not re.fullmatch(catalog.IGNORED_UNIT_PATTERN, u)]


def repair_units(_args):
    units = failed_units()
    for unit in units:
        if unit.endswith((".service", ".mount", ".socket")):
            run(["systemctl", "restart", unit], check=False)
    if not units:
        return
    # Check only after a moment, and never reset-failed before: that
    # hid units that fail again right after the restart
    time.sleep(catalog.UNIT_SETTLE_SECONDS)
    still = failed_units()
    fixed = [u for u in units if u not in still]
    if fixed:
        run(["systemctl", "reset-failed"] + fixed)
    if still:
        raise Fail("still failing: " + ", ".join(still))


