#
# NazoOS: services enabled by default when their package is installed.
# Read before openSUSE's 95-default-SUSE.preset and 99-default.preset
# (disable *), the first matching line wins. Users can still disable them.
enable coolercontrold.service
enable nazoos-xone-firmware.timer
# TCP BBR, bbr3 on kernel-nazoos (each unit checks the kernel itself)
enable nazoos-tcp-bbr.service
enable nazoos-tcp-bbr3.service
# Firmware metadata for fwupd/Discover (off in openSUSE's presets)
enable fwupd-refresh.timer
