# SATA link power management: max_performance avoids latency spikes
# when the link wakes up from a low-power state. Only written when the
# value differs: virtual AHCI controllers (QEMU, VirtualBox) report
# max_performance but reject the write with "Operation not supported"
ACTION=="add", SUBSYSTEM=="scsi_host", KERNEL=="host*", ATTR{link_power_management_policy}=="?*", ATTR{link_power_management_policy}!="max_performance", ATTR{link_power_management_policy}="max_performance"
