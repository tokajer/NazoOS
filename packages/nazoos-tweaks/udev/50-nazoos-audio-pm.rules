# Disable HDA audio power saving: avoids pops/clicks and the delay
# when the codec wakes up (costs a little battery on laptops)
ACTION=="add", SUBSYSTEM=="module", KERNEL=="snd_hda_intel", ATTR{parameters/power_save}="0"
