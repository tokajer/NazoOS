<services>
  <!-- Take .spec and .changes from our GitHub repo -->
  <service name="obs_scm">
    <param name="url">https://github.com/tokajer/NazoOS.git</param>
    <param name="scm">git</param>
    <param name="revision">main</param>
    <param name="subdir">packages/game-devices-udev</param>
    <param name="filename">game-devices-udev-packaging</param>
    <param name="extract">game-devices-udev.spec</param>
    <param name="extract">game-devices-udev.changes</param>
  </service>
  <!-- Upstream release tarball: downloaded from the Source0 URL of the spec -->
  <service name="download_files"/>
</services>
